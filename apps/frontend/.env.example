# Copy to `.env.local` (gitignored) to point the dev server at a specific
# signaling broker. With none of these set, PeerJS uses its public cloud;
# `pnpm dev:p2p` sets host/port/path itself for the local PeerServer.

VITE_PEER_HOST=peer.example.com
VITE_PEER_PORT=443
VITE_PEER_PATH=/

# Needed only when the dev server is http:// and the broker is https://.
# Leave unset in production builds, where page and broker share a protocol.
VITE_PEER_SECURE=true

# ICE / TURN relay — see the TURN section of apps/peerserver/README.md.
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
# VITE_STUN_URL=stun:stun.l.google.com:19302
