# Copy to .env next to compose.yaml and fill both in. Compose refuses to start
# if either is missing.

# Domain whose A record points at this host. Caddy requests a certificate for
# exactly this name, so DNS must resolve before the first `docker compose up`.
PEER_DOMAIN=peer.example.com

# Image to run. Pin a released tag for production; :latest moves on every
# peerserver-v* tag, and sha-<short> tags come from manual workflow runs.
PEERSERVER_IMAGE=ghcr.io/mythhand/releaseboardgamep2p-peerserver:latest

# --- TURN (coturn) ---
# Realm for the relay; use the same domain the signaling server answers on.
TURN_DOMAIN=peer.example.com
# Long-term credentials. The frontend embeds these in its bundle, so treat them
# as public: rotating them means rebuilding the frontend. Generate the password
# with `openssl rand -hex 24`.
TURN_USER=release
TURN_PASSWORD=
